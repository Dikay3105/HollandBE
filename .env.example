# =====================================================================
#  Mẫu cấu hình BE – chép thành file .env (KHÔNG commit file .env)
#  Trên Render: Dashboard → service BE → Environment → thêm từng biến bên dưới
# =====================================================================

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=5000
# RENDER_URL=https://<ten-app>.onrender.com   # để server tự ping giữ thức

# =====================================================================
#  AI viết lời khuyên – tất cả đều MIỄN PHÍ, thêm càng nhiều càng ổn định.
#  Thứ tự: quota theo NGÀY dùng trước (tiếng Việt tốt → kém), credit THÁNG sau, quota MỘT LẦN để dành:
#    Gemini → Groq → OpenRouter → Z.ai → LongCat → Vercel → Cloudflare → Alibaba Qwen
#  Mỗi nơi có giới hạn lượt/phút; nơi tốt kín lượt thì bài kế tiếp tự chuyển sang nơi kế tiếp,
#  tất cả kín thì học sinh xếp hàng chờ lượt trống. Hết quota ngày ở mọi nơi → lời khuyên mẫu,
#  BE tự viết lại bằng AI khi có lượt. Nhà cung cấp nào để trống thì tự bỏ qua.
#  Muốn nhiều key cho cùng nhà cung cấp: thêm _2, _3 ... (VD GEMINI_API_KEY_2=...)
# =====================================================================

# 1) Google Gemini – tiếng Việt tốt nhất (free: 5 lượt/phút, 20 lượt/ngày mỗi model)
#    https://aistudio.google.com/apikey → Create API key (đăng nhập Gmail, không cần thẻ)
GEMINI_API_KEY=

# 1b) Alibaba Qwen (Model Studio quốc tế) – ~1 triệu token free MỖI model, dùng trong 90 ngày, KHÔNG reset
#    (chỉ dùng khi các nơi khác kín lượt / hết quota ngày)
#    https://modelstudio.console.alibabacloud.com → chọn vùng Singapore → API Key
#    ⚠ BẬT "Free quota only" trong console, nếu không hết quota sẽ tự tính tiền
DASHSCOPE_API_KEY=

# 1c) LongCat (Meituan) – quota token free mỗi ngày (~500k token ≈ 100 bài)
#    https://longcat.chat/platform → API Keys
LONGCAT_API_KEY=

# 1d) Vercel AI Gateway – $5 credit free mỗi 30 ngày (≈ 5.000 bài với gemini-2.5-flash-lite)
#    https://vercel.com → đăng nhập → AI Gateway → API Keys → Create key
#    Phải gắn thẻ mới dùng được, nhưng ⚠ KHÔNG mua credit và KHÔNG bật Auto top-up
#    (mua credit = chuyển sang gói trả phí, mất $5 free hằng tháng)
AI_GATEWAY_API_KEY=

# 2) Groq – rất nhanh
#    https://console.groq.com/keys → Create API Key
GROQ_API_KEY=

# 3) OpenRouter (đang dùng) – khoảng 50 lượt/ngày mỗi tài khoản free
#    https://openrouter.ai/settings/keys
OPENROUTER_API_KEY_1=

# 4) Z.ai (GLM) – model glm-…-flash miễn phí, viết đa ngôn ngữ tốt
#    https://z.ai → đăng ký → API Keys (https://z.ai/manage-apikey/apikey-list)
ZAI_API_KEY=

# 5) Cloudflare Workers AI – 10.000 neurons/ngày (cần CẢ 2 biến)
#    Account ID: dash.cloudflare.com → trang Overview, cột phải
#    Token: My Profile → API Tokens → Create Token → mẫu "Workers AI"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------
#  Tuỳ chọn nâng cao (để trống = tự động)
# ---------------------------------------------------------------------
# Thứ tự thử nhà cung cấp:
# AI_PROVIDERS=gemini,groq,openrouter,zai,longcat,vercel,cloudflare,alibaba,custom
# Số bài AI viết cùng lúc (mặc định 8):
# AI_MAX_CONCURRENT=8
# Ghi đè giới hạn lượt/phút mỗi key (chỉ cần khi nhiều key thuộc CÙNG 1 tài khoản, VD 2 key OpenRouter
# cùng tài khoản dùng chung 20 lượt/phút → đặt 10). Mỗi tài khoản 1 key thì không cần.
# OPENROUTER_RPM=10
# GEMINI_RPM=5
# Chỉ định model cố định cho từng nơi (mặc định tự dò model tốt nhất):
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# AI_MODELS=google/gemma-4-31b-it:free          # (của OpenRouter)
# ZAI_MODELS=glm-4.7-flash
# ALIBABA_MODELS=qwen-plus,qwen-flash
# VERCEL_MODELS=google/gemini-2.5-flash-lite,openai/gpt-oss-120b
# LONGCAT_MODELS=LongCat-Flash-Chat
# CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Bất kỳ API chuẩn OpenAI nào khác (VD Ollama tự host):
# AI_CUSTOM_BASE_URL=http://localhost:11434/v1
# AI_CUSTOM_API_KEY=ollama
# AI_CUSTOM_MODELS=qwen2.5:14b
